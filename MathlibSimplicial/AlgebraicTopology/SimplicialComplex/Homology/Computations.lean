module

public import MathlibSimplicial.AlgebraicTopology.SimplicialComplex.Clique
public import MathlibSimplicial.AlgebraicTopology.SimplicialComplex.Dimension
public import MathlibSimplicial.AlgebraicTopology.SimplicialComplex.Homology.Basic
public import Mathlib.AlgebraicTopology.SimplicialSet.Homology.HomologyZero
public import Mathlib.AlgebraicTopology.SimplicialSet.Homology.Nondegenerate
public import Mathlib.Combinatorics.SimpleGraph.Connectivity.Connected

/-!
# First homology computations

## Homology vanishes above the dimension

If every face of `K` has at most `d` vertices, every simplex of `K.toSSet` in degree `n ≥ d`
is degenerate. Mathlib then shows that `Hₙ(K.toSSet) = 0` by passing to the normalized chain
complex, which only has the nondegenerate simplices. In terms of `PreAbstractSimplicialComplex.dim`:
`Hₙ(K; R) = 0` for `n > dim K`.

## `H₀` and connected components

Mathlib identifies `H₀` of a simplicial set `X` with a direct sum of copies of `R` indexed by
`π₀ X`, the quotient of the `0`-simplices by the relation generated by edges. For `K.toSSet`, the
`0`-simplices are the vertices of `K` and the nondegenerate edges are the edges of `K`. So
`π₀ K.toSSet` is the set of connected components of the 1-skeleton graph `K.graph`, restricted
to the vertices of `K` (`K.vertexGraph`). We prove this as an equivalence `π₀Equiv` and deduce

  `H₀(K; R) ≅ ⨁_{components} R`,

which is `R` itself when the 1-skeleton is connected.

## Main declarations

* `PreAbstractSimplicialComplex.isZero_homology_of_card_le`,
  `PreAbstractSimplicialComplex.isZero_homology_of_dim_le`.
* `PreAbstractSimplicialComplex.vertexGraph`: the 1-skeleton as a graph on the vertex set.
* `PreAbstractSimplicialComplex.π₀Equiv : π₀ K.toSSet ≃ K.vertexGraph.ConnectedComponent`.
* `PreAbstractSimplicialComplex.homology₀Iso`,
  `PreAbstractSimplicialComplex.homology₀IsoOfConnected`.
-/

@[expose] public section

open CategoryTheory Limits Simplicial Finset

universe v u w

namespace PreAbstractSimplicialComplex

variable {ι : Type u} [LinearOrder ι] (K : PreAbstractSimplicialComplex ι)
variable {C : Type w} [Category.{v} C] [HasCoproducts.{u} C] [Preadditive C]

section Dimension

variable [CategoryWithHomology C] (R : C)

theorem isZero_homology_of_card_le {d n : ℕ} (h : ∀ s ∈ K, s.card ≤ d) (hn : d ≤ n) :
    IsZero (K.homology R n) :=
  have := K.hasDimensionLT_toSSet h
  SSet.isZero_homology_of_hasDimensionLT K.toSSet R n d hn

theorem isZero_homology_of_dim_le {d n : ℕ} (h : K.dim ≤ ((d : ℕ∞) : WithBot ℕ∞))
    (hn : d < n) : IsZero (K.homology R n) :=
  K.isZero_homology_of_card_le R (dim_le_iff.1 h) hn

end Dimension

section Components

/-- The 1-skeleton of `K` as a graph on its vertex set. -/
abbrev vertexGraph : SimpleGraph K.vertices := K.graph.induce K.vertices

theorem mk_eq_mk_of_le {a b : K.vertices} (hab : a.1 ≤ b.1) (h : {a.1, b.1} ∈ K) :
    SSet.π₀.mk (K.simplexOfVertex a) = SSet.π₀.mk (K.simplexOfVertex b) := by
  have e := SSet.π₀.sound (SSet.Edge.mk' (K.edgeSimplex hab h))
  rwa [δ_one_edgeSimplex, δ_zero_edgeSimplex] at e

theorem mk_eq_mk_of_adj {a b : K.vertices} (h : K.vertexGraph.Adj a b) :
    SSet.π₀.mk (K.simplexOfVertex a) = SSet.π₀.mk (K.simplexOfVertex b) := by
  have hab : {a.1, b.1} ∈ K := (K.graph_adj.1 h).2
  rcases le_total a.1 b.1 with hle | hle
  · exact K.mk_eq_mk_of_le hle hab
  · exact (K.mk_eq_mk_of_le hle (pair_comm a.1 b.1 ▸ hab)).symm

theorem mk_eq_mk_of_walk {a b : K.vertices} (p : K.vertexGraph.Walk a b) :
    SSet.π₀.mk (K.simplexOfVertex a) = SSet.π₀.mk (K.simplexOfVertex b) := by
  induction p with
  | nil => rfl
  | cons h _ ih => exact (K.mk_eq_mk_of_adj h).trans ih

/-- The two endpoints of a `1`-simplex of `K.toSSet` lie in the same component of the
1-skeleton: either they are equal, or they span an edge of `K`. -/
theorem reachable_of_simplex (s : K.toSSet _⦋1⦌) :
    K.vertexGraph.Reachable (K.vertexOfSimplex (K.toSSet.δ 1 s))
      (K.vertexOfSimplex (K.toSSet.δ 0 s)) := by
  by_cases hab : K.vertexOfSimplex (K.toSSet.δ 1 s) = K.vertexOfSimplex (K.toSSet.δ 0 s)
  · rw [hab]
  · apply SimpleGraph.Adj.reachable
    refine K.graph_adj.2 ⟨fun h ↦ hab (Subtype.ext h), ?_⟩
    have hs := (K.mem_nerveSubcomplex s.1).1 s.2
    have e : (univ : Finset (Fin 2)).image s.1.obj = {s.1.obj 0, s.1.obj 1} := by
      ext
      simp [Fin.exists_fin_two, eq_comm]
    exact (congrArg (· ∈ K) e).mp hs

theorem reachable_of_edge {x₀ x₁ : K.toSSet _⦋0⦌} (e : K.toSSet.Edge x₀ x₁) :
    K.vertexGraph.Reachable (K.vertexOfSimplex x₀) (K.vertexOfSimplex x₁) := by
  have h := K.reachable_of_simplex e.edge
  rwa [e.src_eq, e.tgt_eq] at h

/-- The connected components of `K.toSSet` are those of the 1-skeleton of `K`. -/
noncomputable def π₀Equiv : SSet.π₀ K.toSSet ≃ K.vertexGraph.ConnectedComponent where
  toFun := SSet.π₀.lift (fun x ↦ K.vertexGraph.connectedComponentMk (K.vertexOfSimplex x))
    fun _ _ e ↦ SimpleGraph.ConnectedComponent.sound (K.reachable_of_edge e)
  invFun := SimpleGraph.ConnectedComponent.lift (fun a ↦ SSet.π₀.mk (K.simplexOfVertex a))
    fun _ _ p _ ↦ K.mk_eq_mk_of_walk p
  left_inv x := by
    induction x using SSet.π₀.rec
    simp
  right_inv c := by
    induction c using SimpleGraph.ConnectedComponent.ind
    rfl

variable [CategoryWithHomology C] (R : C)

/-- `H₀(K; R)` is a direct sum of copies of `R`, one for each connected component of the
1-skeleton of `K`. -/
noncomputable def homology₀Iso :
    K.homology R 0 ≅ ∐ fun _ : K.vertexGraph.ConnectedComponent ↦ R :=
  K.toSSet.homology₀Iso R ≪≫ Sigma.reindex K.π₀Equiv (fun _ ↦ R)

/-- If the 1-skeleton of `K` is connected, `H₀(K; R) ≅ R`. -/
noncomputable def homology₀IsoOfConnected (h : K.vertexGraph.Connected) :
    K.homology R 0 ≅ R :=
  letI : Unique K.vertexGraph.ConnectedComponent :=
    ⟨⟨K.vertexGraph.connectedComponentMk h.nonempty.some⟩, fun c ↦ c.ind fun _ ↦
      SimpleGraph.ConnectedComponent.sound (h.preconnected _ _)⟩
  K.homology₀Iso R ≪≫ coproductUniqueIso _

end Components

end PreAbstractSimplicialComplex
